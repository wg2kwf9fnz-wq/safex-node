# Rendered by the nginx image's envsubst at start-up (STRATUM_API_TOKEN only).
server {
    listen 80;
    server_name _;

    # Docker's embedded DNS (fixed address 127.0.0.11 inside every compose network). Upstreams are resolved per request (variables below) so nginx
    # still starts if the node or stratum container is not up yet.
    resolver 127.0.0.11 valid=10s ipv6=off;

    root /usr/share/nginx/html;
    index index.html;

    add_header Cache-Control "no-store" always;

    gzip on;
    gzip_types text/html application/json;
    gzip_min_length 512;

    location / {
        try_files $uri /index.html;
    }

    # Anything else under the API prefixes is an error, not the page.
    location /api/ { return 404; }
    location /stratum-api/ { return 404; }

    location = /api/get_info {
        set $node_upstream http://node:17402;
        proxy_pass $node_upstream/get_info;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 10s;
    }

    # Stratum gateway API (read-only stats). The token never reaches the browser: nginx adds it.
    # The page itself sits behind Umbrel's app_proxy login.
    location = /stratum-api/chain {
        set $stratum_upstream http://stratum:8080;
        proxy_pass $stratum_upstream/chain;
        proxy_http_version 1.1;
        proxy_set_header Authorization "Bearer ${STRATUM_API_TOKEN}";
        proxy_read_timeout 10s;
    }

    location = /stratum-api/state {
        set $stratum_upstream http://stratum:8080;
        proxy_pass $stratum_upstream/state;
        proxy_http_version 1.1;
        proxy_set_header Authorization "Bearer ${STRATUM_API_TOKEN}";
        proxy_read_timeout 10s;
    }
}
